<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/LinkUp.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/form_label_title" />

            <EditText
                android:id="@+id/form_title"
                style="@style/LinkUp.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="80" />

            <TextView
                style="@style/LinkUp.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/form_label_category" />

            <Spinner
                android:id="@+id/form_category"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="4dp" />

            <TextView
                style="@style/LinkUp.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/form_label_description" />

            <EditText
                android:id="@+id/form_description"
                style="@style/LinkUp.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="@string/form_hint_description"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="500"
                android:minLines="3" />

            <TextView
                style="@style/LinkUp.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/form_label_when" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/form_date"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    app:icon="@drawable/ic_calendar"
                    />

                <Button
                    android:id="@+id/form_time"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="2"
                    app:icon="@drawable/ic_time"
                    />
            </LinearLayout>

            <TextView
                style="@style/LinkUp.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/form_label_place" />

            <EditText
                android:id="@+id/form_place"
                style="@style/LinkUp.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/form_hint_place"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLength="80" />

            <TextView
                android:id="@+id/form_location_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ink_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/form_pick_map"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/form_pick_map" />

                <Button
                    android:id="@+id/form_use_current"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/form_use_current" />
            </LinearLayout>

            <TextView
                style="@style/LinkUp.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/form_label_spots" />

            <NumberPicker
                android:id="@+id/form_spots"
                android:layout_width="wrap_content"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal" />

            <TextView
                style="@style/LinkUp.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/form_label_join_mode" />

            <RadioGroup
                android:id="@+id/form_join_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkedButton="@+id/form_mode_open">

                <RadioButton
                    android:id="@+id/form_mode_open"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/form_mode_open" />

                <RadioButton
                    android:id="@+id/form_mode_approval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/form_mode_approval" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/form_public_place"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/form_public_place" />

            <Button
                android:id="@+id/form_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/form_post" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
