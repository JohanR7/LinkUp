<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Two RadioButtons styled as a segmented control -->
    <RadioGroup
        android:id="@+id/my_plans_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_segment_group"
        android:orientation="horizontal"
        android:padding="3dp">

        <RadioButton
            android:id="@+id/tab_hosting"
            style="@style/LinkUp.Segment"
            android:text="@string/tab_hosting" />

        <RadioButton
            android:id="@+id/tab_joined"
            style="@style/LinkUp.Segment"
            android:text="@string/tab_joined" />
    </RadioGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/my_plans_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="96dp" />

        <TextView
            android:id="@+id/my_plans_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:textColor="@color/ink_muted" />
    </FrameLayout>
</LinearLayout>
